# Secret used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# First-run seed accounts (only used when data/db.json does not exist yet)
SEED_ADMIN_EMAIL=admin@onradarcrm.com
SEED_ADMIN_PASSWORD=OnRadarAdmin!2026
SEED_CLIENT_EMAIL=demo@sibleyfinancialgroup.com
SEED_CLIENT_PASSWORD=SibleyDemo!2026

# Where the JSON data store lives (defaults to ./data)
# DATA_DIR=/var/lib/onradar
